    UC8_1 ..> UC8_6 : <<include>>
  }

  package "9. Lắp đặt & Bàn giao" {
    usecase "Theo dõi lắp đặt" as UC9_1
    usecase "Cập nhật bước LĐ" as UC9_2
    usecase "Chuyển sang bàn giao" as UC9_3
