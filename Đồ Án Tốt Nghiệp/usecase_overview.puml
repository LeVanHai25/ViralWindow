@startuml UseCase_TongQuan_ViralWindow
left to right direction
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor #A80036
  ArrowColor #A80036
}

actor "Admin" as Admin
actor "Quản lý" as Manager
actor "Nhân viên" as Employee
actor "Hệ thống" as System

Manager --|> Admin : kế thừa
Employee --|> Manager : kế thừa

rectangle "Hệ thống ViralWindow - Phần mềm Quản lý Nhôm Kính" {

  package "1. Xác thực & Phân quyền" {
    usecase "Đăng nhập" as UC1_1
    usecase "Đăng ký" as UC1_2
    usecase "Quên mật khẩu" as UC1_3
    usecase "Cập nhật hồ sơ" as UC1_4
    usecase "Quản lý người dùng" as UC1_6
    usecase "Quản lý chức vụ" as UC1_7
    usecase "Phân quyền RBAC" as UC1_8
    UC1_3 ..> UC1_1 : <<extend>>
    UC1_7 ..> UC1_8 : <<include>>
  }

  package "2. Khách hàng & CRM" {
    usecase "Quản lý khách hàng" as UC2_1
    usecase "Quản lý lịch hẹn" as UC2_2
    usecase "Ghi nhận tương tác" as UC2_3
    usecase "Cập nhật trạng thái KH" as UC2_4
  }

  package "3. Quản lý Dự án" {
    usecase "CRUD Dự án" as UC3_1
    usecase "Theo dõi tiến độ" as UC3_2
    usecase "Quản lý cửa/sản phẩm" as UC3_3
    usecase "Import từ báo giá" as UC3_4
    usecase "Hủy/Khôi phục DA" as UC3_5
    usecase "Xuất báo cáo DA" as UC3_6
    usecase "Nhật ký hoạt động" as UC3_7
    UC3_4 ..> UC3_1 : <<extend>>
    UC3_1 ..> UC3_7 : <<include>>
  }

  package "4. Báo giá" {
    usecase "CRUD Báo giá" as UC4_1
    usecase "Quản lý hạng mục" as UC4_2
    usecase "Tạo phiên bản mới" as UC4_3
    usecase "Ký hợp đồng" as UC4_4
    usecase "Xác nhận đặt cọc" as UC4_5
    usecase "Xuất PDF/Excel" as UC4_6
    usecase "Tính giá từ BOM" as UC4_7
    UC4_1 ..> UC4_2 : <<include>>
    UC4_7 ..> UC4_1 : <<extend>>
    UC4_4 ..> UC4_5 : <<include>>
  }

  package "5. Thiết kế" {
    usecase "Quản lý mẫu cửa" as UC5_1
    usecase "Bản vẽ sản xuất" as UC5_2
    usecase "Quy trình duyệt TK" as UC5_3
    usecase "Quản lý revision" as UC5_4
    usecase "Khóa bản thiết kế" as UC5_5
    usecase "Danh mục sản phẩm" as UC5_6
    UC5_3 ..> UC5_5 : <<include>>
    UC5_4 ..> UC5_3 : <<extend>>
  }

  package "6. BOM & Công thức" {
    usecase "Tính BOM tự động" as UC6_1
    usecase "Công thức cắt nhôm" as UC6_2
    usecase "Tối ưu cắt thanh" as UC6_3
    usecase "Tính kích thước kính" as UC6_4
    usecase "Xuất BOM Excel" as UC6_5
    usecase "Tạo YCMH từ BOM" as UC6_6
    UC6_1 ..> UC6_2 : <<include>>
    UC6_1 ..> UC6_4 : <<include>>
    UC6_6 ..> UC6_1 : <<include>>
  }

  package "7. Kho & Tồn kho" {
    usecase "CRUD Vật tư" as UC7_1
    usecase "Phiếu nhập/xuất kho" as UC7_2
    usecase "Thẻ kho & Tồn kho" as UC7_3
    usecase "Cảnh báo tồn kho" as UC7_4
    usecase "Quản lý phế liệu" as UC7_5
