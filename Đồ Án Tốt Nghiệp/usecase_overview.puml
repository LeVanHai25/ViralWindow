Employee --> UC3_2
Employee --> UC3_3
Employee --> UC4_1
Employee --> UC4_4
Employee --> UC5_1
Employee --> UC5_2
Employee --> UC5_3
Employee --> UC6_1
Employee --> UC6_3
Employee --> UC7_1
Employee --> UC7_2
Employee --> UC7_5
Employee --> UC8_1
Employee --> UC8_2
Employee --> UC8_5
Employee --> UC9_1
Employee --> UC9_2
Employee --> UC10_1
Employee --> UC10_2
Employee --> UC11_1
Employee --> UC11_3
Employee --> UC12_1
Employee --> UC12_2
Employee --> UC12_4
Employee --> UC13_1
Employee --> UC13_2
Employee --> UC14_1
Employee --> UC14_2
Employee --> UC17_2

' Manager
Manager --> UC3_5
Manager --> UC3_6
Manager --> UC10_4
Manager --> UC10_5
Manager --> UC11_2
Manager --> UC12_5
Manager --> UC15_1
Manager --> UC15_2
