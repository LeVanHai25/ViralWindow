    usecase "Gợi ý nhập hàng AI" as UC7_7
    UC7_2 ..> UC7_3 : <<include>>
  }

  package "8. Sản xuất" {
    usecase "Quản lý sản xuất" as UC8_1
    usecase "Cập nhật hoàn thành" as UC8_2
    usecase "Gán vật tư cho SP" as UC8_3
    usecase "Chuyển giai đoạn" as UC8_4
    usecase "Lệnh sản xuất" as UC8_5
