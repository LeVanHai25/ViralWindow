    UC9_4 ..> UC9_5 : <<include>>
    UC9_2 ..> UC9_3 : <<extend>>
  }

  package "10. Tài chính & Công nợ" {
    usecase "Quản lý thu chi" as UC10_1
    usecase "Quản lý công nợ" as UC10_2
    usecase "Ghi nhận thanh toán" as UC10_3
    usecase "Dashboard tài chính" as UC10_4
    usecase "Báo cáo lãi lỗ" as UC10_5
    usecase "Xuất Excel tài chính" as UC10_7
    UC10_2 ..> UC10_3 : <<include>>
  }

  package "11. Mua hàng" {
    usecase "CRUD Yêu cầu MH" as UC11_1
    usecase "Duyệt yêu cầu" as UC11_2
    usecase "Quản lý NCC" as UC11_3
    usecase "Xuất Excel YCMH" as UC11_4
  }

  package "12. Nhân sự" {
    usecase "Chấm công" as UC12_1
    usecase "Xem chấm công CN" as UC12_2
    usecase "Thống kê chấm công" as UC12_3
    usecase "Gửi đơn nghỉ phép" as UC12_4
    usecase "Duyệt nghỉ phép" as UC12_5
    usecase "Quản lý ca làm" as UC12_6
  }

  package "13. Kế hoạch CV" {
    usecase "CRUD Kế hoạch" as UC13_1
    usecase "Thảo luận" as UC13_2
    usecase "Checklist" as UC13_4
    UC13_1 ..> UC13_4 : <<include>>
  }

  package "14. Chat nội bộ" {
    usecase "Tạo cuộc trò chuyện" as UC14_1
    usecase "Gửi/nhận tin nhắn" as UC14_2
    usecase "Gửi file đính kèm" as UC14_3
    usecase "Ghim tin nhắn" as UC14_4
    usecase "Quản lý thành viên" as UC14_5
    UC14_2 ..> UC14_3 : <<extend>>
  }

  package "15. Báo cáo" {
    usecase "Dashboard tổng quan" as UC15_1
    usecase "BC doanh thu" as UC15_2
    usecase "BC sản xuất" as UC15_3
    usecase "BC tồn kho" as UC15_4
    usecase "BC chi nhánh" as UC15_5
  }

  package "16. Đại lý" {
    usecase "CRUD Đại lý" as UC16_1
    usecase "Dashboard đại lý" as UC16_2
    usecase "Phân bổ KH" as UC16_3
  }

  package "17. Thông báo" {
    usecase "Thông báo realtime" as UC17_1
    usecase "Đánh dấu đã đọc" as UC17_2
    usecase "Nhật ký hệ thống" as UC17_3
  }
}

